                                                                                      "parameters":  {
                                                                                                         "entityName":  "cat_copilottestresults",
                                                                                                         "recordId":  "@items(\u0027Apply_to_each:_Child_Agent_Test_Results\u0027)?[\u0027cat_copilottestresultid\u0027]",
                                                                                                         "item/cat_name":  "@items(\u0027Apply_to_each:_Child_Agent_Test_Results\u0027)?[\u0027cat_name\u0027]",
                                                                                                         "item/cat_resultcode":  "@if(\r\n    equals(\r\n        items(\u0027Apply_to_each:_Child_Agent_Test_Results\u0027)?[\u0027cat_copilottestid/cat_testtypecode\u0027], \r\n        2\r\n    ), \r\n    if(\r\n        equals(\r\n            if(\r\n                not(empty(first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentTitle\u0027])), \r\n                first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentTitle\u0027], \r\n                if(\r\n                    not(empty(first(body(\u0027Filter_array_with_valueType_UnknownIntent_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027])), \r\n                    first(body(\u0027Filter_array_with_valueType_UnknownIntent_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027], \r\n                    if(\r\n                        not(empty(first(body(\u0027Filter_array_with_valueType_IntentCandidates_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027])), \r\n                        first(body(\u0027Filter_array_with_valueType_IntentCandidates_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027], \r\n                        if(\r\n                            not(empty(outputs(\u0027Get_Topic_Name_for_child_test\u0027)?[\u0027body\u0027]?[\u0027name\u0027])), \r\n                            outputs(\u0027Get_Topic_Name_for_child_test\u0027)?[\u0027body\u0027]?[\u0027name\u0027], \r\n                            \u0027\u0027\r\n                        )\r\n                    )\r\n                )\r\n            ), \r\n            items(\u0027Apply_to_each:_Child_Agent_Test_Results\u0027)?[\u0027cat_copilottestid/cat_expectedtopicname\u0027]\r\n        ), \r\n        1, \r\n        2\r\n    ), \r\n    items(\u0027Apply_to_each:_Child_Agent_Test_Results\u0027)?[\u0027cat_resultcode\u0027]\r\n)",
                                                                                                         "item/cat_citations":  "@first(body(\u0027Filter_array_with_pva-gpt-feedback_not_null_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027channelData\u0027]?[\u0027pva:gpt-feedback\u0027]?[\u0027summarizationOpenAIResponse\u0027]?[\u0027result\u0027]?[\u0027textCitations\u0027]",
                                                                                                         "item/cat_recognizedintentscore":  "@first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentScore\u0027]?[\u0027score\u0027]",
                                                                                                         "item/cat_resultreason":  "@if(\n    equals(\n        items(\u0027Apply_to_each:_Child_Agent_Test_Results\u0027)?[\u0027cat_copilottestid/cat_testtypecode\u0027], \n        2\n    ),\n    if(\n        equals(\n            if(\n                not(empty(first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentTitle\u0027])),\n                first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentTitle\u0027],\n                if(\n                    not(empty(first(body(\u0027Filter_array_with_valueType_UnknownIntent_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027])),\n                    first(body(\u0027Filter_array_with_valueType_UnknownIntent_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027],\n                    if(\n                        not(empty(first(body(\u0027Filter_array_with_valueType_IntentCandidates_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027])),\n                        first(body(\u0027Filter_array_with_valueType_IntentCandidates_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027],\n                        if(\n                            not(empty(outputs(\u0027Get_Topic_Name_for_child_test\u0027)?[\u0027body\u0027]?[\u0027name\u0027])),\n                            outputs(\u0027Get_Topic_Name_for_child_test\u0027)?[\u0027body\u0027]?[\u0027name\u0027],\n                            \u0027\u0027\n                        )\n                    )\n                )\n            ), \n            items(\u0027Apply_to_each:_Child_Agent_Test_Results\u0027)?[\u0027cat_copilottestid/cat_expectedtopicname\u0027]\n        ), \n        \u0027Exact match on the triggered topic or event name\u0027, \n        \u0027Not an exact match on the triggered topic or event name\u0027 \n    ), \n    items(\u0027Apply_to_each:_Child_Agent_Test_Results\u0027)?[\u0027cat_resultreason\u0027]\n)",
                                                                                                         "item/cat_recognizedtopicname":  "@if(\n    not(empty(first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentTitle\u0027])),\n    first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentTitle\u0027],\n    if(\n        not(empty(first(body(\u0027Filter_array_with_valueType_UnknownIntent_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027])),\n        first(body(\u0027Filter_array_with_valueType_UnknownIntent_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027],\n        if(\n            not(empty(first(body(\u0027Filter_array_with_valueType_IntentCandidates_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027])),\n            first(body(\u0027Filter_array_with_valueType_IntentCandidates_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027valueType\u0027],\n            if(\n                not(empty(outputs(\u0027Get_Topic_Name_for_child_test\u0027)?[\u0027body\u0027]?[\u0027name\u0027])),\n                outputs(\u0027Get_Topic_Name_for_child_test\u0027)?[\u0027body\u0027]?[\u0027name\u0027],\n                \u0027\u0027\n            )\n        )\n    )\n)",
                                                                                                         "item/cat_recognizedtopicid":  "@if(\n    not(empty(first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentId\u0027])),\n    first(body(\u0027Filter_array_with_valueType_IntentRecognition_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027intentId\u0027],\n    if(\n        not(empty(first(body(\u0027Filter_array_with_valueType_DialogRedirect_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027targetDialogId\u0027])),\n        first(body(\u0027Filter_array_with_valueType_DialogRedirect_for_child_test\u0027))?[\u0027activity\u0027]?[\u0027value\u0027]?[\u0027targetDialogId\u0027],\n        \u0027\u0027\n    )\n)"
                                                                                                     },
